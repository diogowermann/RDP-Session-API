RDP_SESSION_DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/rdp_session_service
RDP_SESSION_LOG_LEVEL=INFO
RDP_SESSION_QUERY_API_KEY=replace-with-a-long-random-value

# Phase 6 asynchronous source correlation. Keep disabled until the resolver
# endpoint and dedicated service-to-service key are configured.
RDP_SESSION_CORRELATION_ENABLED=false
RDP_SESSION_RESOLVER_BASE_URL=http://127.0.0.1:8090
RDP_SESSION_RESOLVER_API_KEY=replace-with-dedicated-resolver-key
RDP_SESSION_RESOLVER_TIMEOUT_SECONDS=5
RDP_SESSION_CORRELATION_POLL_SECONDS=30
RDP_SESSION_CORRELATION_BATCH_SIZE=100
RDP_SESSION_CORRELATION_MAX_ATTEMPTS=5
RDP_SESSION_CORRELATION_RETRY_BASE_SECONDS=60
